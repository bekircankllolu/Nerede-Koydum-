{
  "cli": {
    "version": ">= 21.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "preview-ios-simulator": {
      "distribution": "internal",
      "ios": {
        "simulator": true
      }
    },
    "production": {
      "autoIncrement": true,
      "ios": {
        "credentialsSource": "local"
      },
      "android": {
        "buildType": "app-bundle"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6799027280",
        "ascApiKeyPath": "credentials/asc-api-key.p8",
        "ascApiKeyIssuerId": "439eb0f4-c0cd-48a6-b052-9747790e95ef",
        "ascApiKeyId": "PVF3NQX44M"
      }
    }
  }
}
